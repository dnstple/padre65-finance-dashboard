# Copy this file to .env and fill in the values. Never commit or share .env.

# --- Wise (Settings > Integrations and tools > API tokens, create a READ ONLY token)
WISE_API_TOKEN=
# Private key used to sign Wise's SCA challenge (UK accounts). See README "Wise setup".
WISE_PRIVATE_KEY_PATH=keys/wise_private.pem
# Optional: leave blank to auto-detect your business profile
WISE_PROFILE_ID=
# How far back to pull statements from
WISE_START_DATE=2025-01-01

# --- Shopify (Dev Dashboard app installed on your store; see README "Shopify setup")
SHOPIFY_STORE=2401d1-3.myshopify.com
# Either a static Admin API access token...
SHOPIFY_ACCESS_TOKEN=
# ...or the app's client credentials (token is fetched automatically)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Used to estimate card fees only if Shopify Payments data isn't accessible
SHOPIFY_FEE_PCT=0.02
SHOPIFY_FEE_FIXED=0.25
# Orders containing only these products are ignored in reports (comma-separated product titles)
EXCLUDE_PRODUCTS=TEST

# --- General
DB_PATH=data/finance.db
BASE_CURRENCY=GBP
# Optional flat packaging cost per shipped order, used if you don't log packaging purchases
PACKAGING_COST_PER_ORDER=0

# Product cost sheet (Google Sheet shared as "anyone with the link can view"). Re-imported on every sync.
COSTS_SHEET_URL=
